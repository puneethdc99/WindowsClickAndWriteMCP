<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowsClickAndWriteMCP</AssemblyName>
    <RootNamespace>WindowsClickAndWriteMCP</RootNamespace>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);NU1701;CA1416</NoWarn>

    <!-- NuGet Tool Packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>windows-click-and-write</ToolCommandName>
    <PackageId>WindowsClickAndWriteMCP</PackageId>
    <Version>1.0.0</Version>
    <Authors>puneethdc99</Authors>
    <Company>puneethdc99</Company>
    <Description>Windows Click &amp; Write MCP Server — local MCP server that allows AI agents to click any UI element and type into any input field on Windows</Description>
    <PackageProjectUrl>https://github.com/puneethdc99/WindowsClickAndWriteMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/puneethdc99/WindowsClickAndWriteMCP</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mcp;model-context-protocol;windows;automation;flaui;click;type</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>
